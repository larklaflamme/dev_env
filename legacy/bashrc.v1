# ============================================================
# >>> dev setup >>>   (appended to Ubuntu's default ~/.bashrc)
# ============================================================

# --- PATH: user binaries and Neovim --------------------------
# Ubuntu only adds ~/.local/bin at login if it already existed,
# so add it here unconditionally (no duplicates).
for _d in "$HOME/.local/bin" "/opt/nvim-linux-x86_64/bin"; do
  case ":$PATH:" in *":$_d:"*) ;; *) PATH="$_d:$PATH" ;; esac
done
unset _d
export PATH

# --- Editor --------------------------------------------------
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim VISUAL=nvim
  alias vim='nvim'
fi

# --- History: big, deduplicated, written immediately ---------
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups      # skip dupes and lines starting with a space
HISTTIMEFORMAT='%F %T  '              # timestamps in `history`
HISTIGNORE='ls:ll:la:cd:pwd:exit:clear:history'
shopt -s histappend cmdhist
case "$PROMPT_COMMAND" in *"history -a"*) ;; *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;; esac   # save each command as it runs

# --- Shell behaviour -----------------------------------------
shopt -s globstar      # ** matches across directories
shopt -s autocd        # type a directory name to cd into it
shopt -s cdspell dirspell   # fix small typos in cd paths
shopt -s checkjobs     # warn before exiting with running jobs

# --- Tool hooks (each only if installed) ---------------------
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
  eval "$(mise hook-env -s bash)"     # put mise tools on PATH now, for the lines below
fi
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

if command -v fzf >/dev/null 2>&1; then
  # fzf >= 0.48 (mise) has built-in integration; apt's 0.44 ships a script instead
  if _fzf_init="$(fzf --bash 2>/dev/null)"; then
    eval "$_fzf_init"
  elif [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
    . /usr/share/doc/fzf/examples/key-bindings.bash
  fi
  unset _fzf_init
fi
command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1 && alias fd='fdfind'
command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1 && alias bat='batcat'

# --- Aliases -------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -la --git --group-directories-first'
  alias lt='eza --tree --level=2 --git-ignore'
else
  alias ll='ls -alFh'
fi
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'
# safer file operations: ask before overwriting
alias cp='cp -i'
alias mv='mv -i'

# --- Machine-specific settings and secrets (never committed) -
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"

# --- Prompt and smart cd: keep these last --------------------
command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"
command -v zoxide   >/dev/null 2>&1 && eval "$(zoxide init bash)"

# <<< dev setup <<<